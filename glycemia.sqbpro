ue="79"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="63"/><column index="2" value="181"/><column index="3" value="114"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TRIGGER IF NOT EXISTS set_profile_default
AFTER INSERT ON patient
FOR EACH ROW
WHEN NEW.profile IS NULL OR NEW.profile = ''
BEGIN
UPDATE patient
SET profile =
CASE (ABS(RANDOM()) % 4)
WHEN 0 THEN 'normal'
WHEN 1 THEN 'hyper'
WHEN 2 THEN 'hypo'
ELSE 'instable'
END
WHERE id = NEW.id;
END;</sql><current_tab id="0"/></tab_sql></sqlb_project>
